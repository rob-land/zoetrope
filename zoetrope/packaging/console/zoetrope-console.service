# zoetrope console mode: a dedicated sway kiosk session on VT8, outside GNOME.
# Started by udev when XREAL glasses are plugged in (99-zoetrope-console.rules),
# stopped on unplug. GNOME's session on tty2 is suspended (not killed) meanwhile.
#
# Manual control:  sudo systemctl start|stop zoetrope-console
# Hotplug toggle:  touch|rm /etc/zoetrope/console-autostart

[Unit]
Description=zoetrope glasses console (sway kiosk on its own VT)
# Only auto-launch when armed.
ConditionPathExists=/etc/zoetrope/console-autostart
Conflicts=getty@tty8.service
After=getty@tty8.service systemd-user-sessions.service

[Service]
Type=simple
User=rob
PAMName=login
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty8
UtmpMode=user
# Let the desktop compositor finish digesting the glasses' hotplug (they add
# HID/audio/net devices) before we take the seat: switching VTs mid-hotplug
# segfaulted Mutter 49.6's libinput input thread (seen 2026-07-31).
ExecStartPre=/usr/bin/sleep 2
# Remember the VT we came from, then switch to VT8 (runs as root: '+').
ExecStartPre=+/usr/local/libexec/zoetrope/zoetrope-vt save-and-switch
ExecStart=/usr/bin/sway -c /etc/zoetrope/sway-kiosk.conf
# Whatever way the session ends, put the user back on their previous VT.
ExecStopPost=+/usr/local/libexec/zoetrope/zoetrope-vt restore
TimeoutStopSec=10
Restart=no
